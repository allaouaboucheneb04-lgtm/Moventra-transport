rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
function signedIn(){return request.auth!=null;} function isAdmin(){return signedIn()&&exists(/databases/$(database)/documents/users/$(request.auth.uid))&&get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role=='admin';}
match /demandes_soumission/{id}{allow create:if true;allow read,update,delete:if isAdmin();}
match /users/{uid}{allow read:if isAdmin()||(signedIn()&&request.auth.uid==uid);allow write:if isAdmin();}
match /devis/{id}{allow read,write:if isAdmin();}
match /factures/{id}{allow read,write:if isAdmin();}
match /taches/{id}{allow read,write:if isAdmin();}
match /clients/{id}{allow read,write:if isAdmin();}
match /parametres/{id}{allow read,write:if isAdmin();}
match /settings/{id}{allow read:if true;allow write:if isAdmin();}
match /notifications/{id}{allow read,write:if isAdmin();}
match /historique/{id}{allow read,write:if isAdmin();}
match /invites/{id}{allow read:if true;allow write:if isAdmin();}
match /{document=**}{allow read,write:if false;}
}}
