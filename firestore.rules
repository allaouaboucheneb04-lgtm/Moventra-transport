rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profileExists() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return profileExists() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    function isEmployee() { return profileExists() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'employe'; }

    match /users/{uid} { allow read: if signedIn() && (request.auth.uid == uid || isAdmin()); allow write: if isAdmin(); }
    match /utilisateurs/{uid} { allow read: if signedIn() && (request.auth.uid == uid || isAdmin()); allow write: if isAdmin(); }
    match /employes/{uid} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /demandes_soumission/{id} { allow create: if true; allow read, update, delete: if isAdmin(); }
    match /travaux/{id} { allow read: if isAdmin() || isEmployee(); allow create, update, delete: if isAdmin(); }
    match /factures/{id} { allow read, write: if isAdmin(); }
    match /parametres/{id} { allow read, write: if isAdmin(); }
    match /promotions/{id} { allow read, write: if isAdmin(); }
    match /historique/{id} { allow read, write: if isAdmin(); }
    match /notifications/{id} { allow read, write: if signedIn(); }
    match /{document=**} { allow read, write: if false; }
  }
}
